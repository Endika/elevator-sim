{
  "name": "elevator-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Configurable elevator simulator: compare dispatch algorithms for any building",
  "license": "MIT",
  "author": "Endika Iglesias",
  "homepage": "https://endika.github.io/elevator-sim/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endika/elevator-sim.git"
  },
  "bugs": "https://github.com/Endika/elevator-sim/issues",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "type:check": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "sweep": "tsx scripts/sweep.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
